# Copy to .env for LOCAL testing only (never commit your real .env).
# In production these go in GitHub repo Settings -> Secrets and variables -> Actions.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
EMAIL_TO=you@example.com

# --- Pick ONE email method ---
# Option A (recommended): Resend. Free 100/day. Until you verify a domain,
# leave EMAIL_FROM blank to use the sandbox sender onboarding@resend.dev.
RESEND_API_KEY=re_...
EMAIL_FROM=Market Digest <onboarding@resend.dev>

# Option B: Gmail SMTP. Requires 2FA on the account + an App Password
# (Google Account -> Security -> App passwords). Leave RESEND_API_KEY unset to use this.
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- Optional ---
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Trump alerts only ---
APIFY_TOKEN=apify_api_...
APIFY_ACTOR_ID=muhammetakkurtt~truth-social-scraper
# APIFY_INPUT_JSON={"profiles":["realDonaldTrump"],"maxItems":5}
LOOKBACK_MINUTES=20
